[Unit]
Description=dsh Web with the Feishu IM channel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/absolute/task/workspace
ExecStart=/absolute/path/to/dsh --profile web --host 127.0.0.1 --no-open
Restart=on-failure
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
