{
  "name": "dsh-feishu-im",
  "version": "0.2.1",
  "description": "Run dsh tasks from Feishu private chats with direct SDK connectivity, live progress and interactive decisions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "feishu",
    "lark",
    "agent",
    "chatbot"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.cjs"
    }
  },
  "files": [
    "bin/",
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE",
    "docs/",
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "examples/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.client-build.json && node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --deny-warnings src tests scripts bin",
    "check": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepack": "npm run build",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.ts",
    "package:check": "npm run build && publint && node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-agent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-cmdline": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.1.7-alpha.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "commander": "^14.0.1",
    "qrcode": "1.5.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-test-runtime": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-scope": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-settings": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-user-questions": "0.1.7-alpha.2",
    "@types/node": "^22.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.28",
    "@types/react-test-renderer": "18.3.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "oxlint": "1.76.0",
    "publint": "^0.3.21",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.9.3",
    "vitest": "4.1.11",
    "ws": "8.21.3"
  },
  "bin": {
    "feishu-im": "./bin/feishu-im.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buaazp/feishu-im.git"
  },
  "homepage": "https://github.com/buaazp/feishu-im#readme",
  "bugs": {
    "url": "https://github.com/buaazp/feishu-im/issues"
  }
}
